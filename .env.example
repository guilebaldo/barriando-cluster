# =============================================================================
# Barriando — plantilla de variables de entorno
# =============================================================================
#
# 1. Copia este archivo:  cp .env.example .env
# 2. Rellena valores reales SOLO en .env (nunca lo commitees).
# 3. Producción: configura las mismas claves en Vercel → Settings → Environment Variables.
# 4. Validación local (no imprime secretos):  npm run env:check
#
# ⚠️  Desarrollo local: usa una rama Neon de DEV, no la de producción.
#     Cloud Agents (Cursor): pega secrets en cursor.com/dashboard → Cloud Agents,
#     nunca en el chat del agente.
#
# =============================================================================

# =============================================
# 📌 URL pública de la app
# =============================================

# Producción (Vercel):
NEXT_PUBLIC_APP_URL="https://barriando.org"
# Local:
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================
# 🔐 Auth.js (NextAuth v5)
# =============================================

# Generar: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
# Alias aceptado por el código: NEXTAUTH_SECRET

AUTH_URL="https://barriando.org"
# Local: AUTH_URL="http://localhost:3000"

AUTH_TRUST_HOST=true

# Alias opcional (cliente next-auth/react):
NEXTAUTH_URL="https://barriando.org"

# Logs extra de OAuth en producción (solo depuración):
# AUTH_DEBUG=true

# =============================================
# 🔑 Google OAuth
# =============================================
# Redirect URI en Google Cloud Console:
#   https://barriando.org/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google  (dev)

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Alias: AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET

# =============================================
# 🍎 Apple Sign In (opcional)
# =============================================

# APPLE_ID=""
# APPLE_SECRET=""
# Alias: AUTH_APPLE_ID, AUTH_APPLE_SECRET

# =============================================
# ✉️ Resend (magic link / correos)
# =============================================

RESEND_API_KEY="re_xxxxxxxx"
# Alias: AUTH_RESEND_KEY
EMAIL_FROM="Barriando <noreply@barriando.org>"
# Alias: AUTH_EMAIL_FROM

# =============================================
# 💳 Stripe
# =============================================
# Local: sk_test_ / pk_test_ + price_ de modo Test.
# Prod (Vercel): sk_live_ / pk_live_ + price_ de modo Live.
# Verificar par secret/publishable: npm run env:check

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Price IDs recurrentes por plan (preferidos sobre STRIPE_PRICE_ID genérico)
STRIPE_PRICE_ID=""
STRIPE_PRICE_ID_VECINO=""
STRIPE_PRICE_ID_NEGOCIO_FAMILIAR=""
STRIPE_PRICE_ID_MEDIANA_EMPRESA=""
STRIPE_PRICE_ID_GRAN_EMPRESA=""

# Local webhooks: stripe listen --forward-to localhost:3000/api/stripe/webhook
# OXXO usa price_data (montos de PLAN_PRICES_MXN). Webhook Live además:
#   checkout.session.async_payment_succeeded
#   checkout.session.async_payment_failed (opcional)

# =============================================
# 🗺️ Google Maps & Places (NEXT_PUBLIC_* = visibles en el navegador)
# =============================================
# Restringe keys en Google Cloud → HTTP referrers (localhost, barriando.org, *.vercel.app)

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=""

# =============================================
# 🏦 Pagos manuales (transferencia)
# =============================================

BARRIANDO_CLABE=""
BARRIANDO_PAYMENT_EMAIL="hola@barriandopuebla.com"
BARRIANDO_BANK_LABEL="STP — Asociación Barriando"

# =============================================
# 👤 Administración
# =============================================
# Backup si User.role = ADMIN falla en DB. Acceso principal: role ADMIN en Neon.

ADMIN_EMAILS="you@example.com"
# Alias: ADMIN_EMAIL

# =============================================
# ⏱️ Cron (Vercel)
# =============================================

CRON_SECRET="generate-a-long-random-string"

# =============================================
# 🗄️ Base de datos (Neon Postgres)
# =============================================
# La app usa DATABASE_URL (Prisma). Usa el endpoint *-pooler* para serverless.

DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Opcional — Neon / Vercel integration (no leídas por src/ directamente):
# DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# NEON_BRANCH=development
